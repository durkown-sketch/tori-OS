# ============================================================
# ToriOS — Environment Variables Example
# Copy this file to .env and fill in all values.
# NEVER commit the real .env file to version control.
# ============================================================

# ----- Django Core -----
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-render-app.onrender.com

# ----- Database (Supabase PostgreSQL) -----
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=recordings

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# ----- JWT Configuration -----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- AI Providers -----
# Google Gemini (primary)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA NIM (alternative)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Active provider: "gemini" or "nvidia"
AI_PROVIDER=gemini

# ----- Speech Recognition (Whisper) -----
OPENAI_API_KEY=your-openai-api-key
WHISPER_MODEL=whisper-1

# If using a self-hosted Whisper endpoint:
# WHISPER_BASE_URL=http://localhost:8080/v1

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=ToriOS

# ----- Email (Meeting Summary) -----
# Use 'console' for dev (prints to terminal) or 'smtp' for real delivery
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ToriOS <noreply@torios.ai>

# ----- Background Tasks -----
# For future Celery integration:
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
